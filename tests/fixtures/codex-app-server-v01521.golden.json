{
  "codex_version": "codex-cli 0.152.1",
  "transport": "jsonrpc-2.0-stdio",
  "methods": ["initialize", "notifications/initialized", "skills/list", "thread/start", "thread/resume", "thread/archive", "turn/start", "mcpServer/elicitation/request"],
  "server_request": {"method": "mcpServer/elicitation/request", "response": {"action": "accept | decline | cancel"}},
  "skill_load_evidence": ["name", "path", "plugin_id", "enabled"],
  "credential_free_deferred_mcp_route": {
    "model_metadata": {"slug": "gpt-5.4-mini", "supports_search_tool": true},
    "provider_capability": {"namespace_tools": true},
    "model_visible_tool": {"type": "tool_search"},
    "search_call": {"type": "tool_search_call", "execution": "client", "arguments": ["query", "limit"]},
    "loaded_call": {"type": "function_call", "fields": ["namespace", "name", "arguments", "call_id"], "namespace_source": "tool_search_output"},
    "confirmed_sequence": ["tool_search_call", "cursor_delegate", "tool_search_call", "cursor_wait", "tool_search_call", "cursor_close_session"],
    "reported_outcome_evidence": {"turn_status": "completed", "turn_identity": "exact turn/start id", "agent_messages": ["CURSOR_EVAL_OK"]},
    "unrelated_features": ["tool_suggest", "deferred_executor", "deferred_tool_world_state"],
    "unsupported_config_keys": ["tools.deferred_namespaces"]
  },
  "turn_start_input": [
    {"type": "text", "fields": ["text", "text_elements"]},
    {"type": "skill", "fields": ["name", "path"]},
    {"type": "mention", "fields": ["name", "path"], "path_prefix": "plugin://"}
  ]
}
